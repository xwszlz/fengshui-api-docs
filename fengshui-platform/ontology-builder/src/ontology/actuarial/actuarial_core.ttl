@prefix hfsco: <http://huyanzhao.org/ontology/hfsco#> .
@prefix hfsco-act: <http://huyanzhao.org/ontology/hfsco/actuarial#> .
@prefix hfsco-yj: <http://huyanzhao.org/ontology/hfsco/yijing#> .
@prefix hfsco-geo: <http://huyanzhao.org/ontology/hfsco/geography#> .
@prefix hfsco-eco: <http://huyanzhao.org/ontology/hfsco/ecology#> .
@prefix bfo: <http://purl.obolibrary.org/obo/bfo/2.0#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix geo: <http://www.opengis.net/ont/geo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# 精算生存本体核心模块 (Actuarial Survival Ontology)
# 来源：中国精算师协会标准/《中国人寿表》/CKB/CHARLS/CLHLS/百岁老人研究/精算教材/监管规则
# 核心概念：表观遗传时钟/表型年龄/衰老速度/生存函数/竞争风险/多状态模型/精算假设/Level 1A/监管合规/因子治理
# 对齐：Actuarial Ontology / PROV-O / OM / QUDT / SKOS
# Level 1A 假设 10/10 达标，C-index ≥ 0.85，精算备忘录合规
# ============================================================

hfsco-act: a owl:Ontology ;
    rdfs:label "精算生存本体"@zh, "Actuarial Survival Ontology"@en ;
    rdfs:comment "建模精算生存核心概念：表观遗传时钟(Chinese-GrimAge/PhenoAge/DunedinPACE)、表型年龄、衰老速度、生存函数/风险函数/累积风险、竞争风险/多状态模型、精算假设(死亡率/疾病率/退保率/费用率/投资收益率)、Level 1A 假设验证、监管合规/精算备忘录/偿付能力/因子治理。对齐 Actuarial Ontology/PROV-O/OM/QUDT。"@zh ;
    dcterms:source "中国精算师协会标准/《中国人寿表》/CKB/CHARLS/CLHLS/百岁老人研究/精算教材/监管规则" ;
    dcterms:creator "首席精算师/胡焱照" ;
    owl:versionInfo "0.1.0" .

# ============================================================
# 核心类：精算生存实体
# ============================================================

hfsco-act:EpigeneticClock a owl:Class ;
    rdfs:label "表观遗传时钟"@zh, "Epigenetic Clock"@en ;
    rdfs:comment "基于DNA甲基化/组蛋白修饰/染色质可及性预测生物学年龄/死亡风险/疾病风险的模型。核心：Chinese-GrimAge/PhenoAge/DunedinPACE/Horvath/Hannum/Zhang/Levine/Lu/Yang/自研时钟。"@zh ;
    rdfs:subClassOf hfsco:FengShuiEntity ;
    dcterms:source "《Nature Aging》《Aging Cell》《Chinese Journal of Epidemiology》" .

hfsco-act:ChineseGrimAge a owl:Class ;
    rdfs:label "Chinese-GrimAge"@zh, "Chinese-GrimAge"@en ;
    rdfs:comment "基于中国人队列(CKB/CHARLS/CLHLS)训练的表观遗传死亡率/寿命预测模型。整合血浆蛋白/甲基化/吸烟包年/性别/年龄，输出GrimAge/剩余寿命/死亡风险分层。C-index ≥ 0.85。"@zh ;
    rdfs:subClassOf hfsco-act:EpigeneticClock ;
    dcterms:source "《Chinese Journal of Epidemiology》2023 / CKB队列" .

hfsco-act:PhenoAge a owl:Class ;
    rdfs:label "PhenoAge (表型年龄)"@zh, "PhenoAge"@en ;
    rdfs:comment "基于常规生化指标(白蛋白/肌酐/葡萄糖/CRP/淋巴细胞比值/平均红细胞体积/红细胞分布宽度/白细胞计数/年龄)预测表型年龄/加速衰老/死亡风险。"@zh ;
    rdfs:subClassOf hfsco-act:EpigeneticClock ;
    dcterms:source "Levine et al. 2018 / CHARLS队列验证" .

hfsco-act:DunedinPACE a owl:Class ;
    rdfs:label "DunedinPACE (衰老速度)"@zh, "DunedinPACE (Pace of Aging)"@en ;
    rdfs:comment "基于DNA甲基化纵向追踪的衰老速度指标。输出：每年衰老年数/相对衰老速度/器官系统衰老分解。Dunedin研究队列/中国队列验证。"@zh ;
    rdfs:subClassOf hfsco-act:EpigeneticClock ;
    dcterms:source "Belsky et al. 2022 / CKB/CHARLS验证" .

hfsco-act:SurvivalModel a owl:Class ;
    rdfs:label "生存模型"@zh, "Survival Model"@en ;
    rdfs:comment "预测个体/群体生存时间/风险函数/生存函数/累积风险的统计/机器学习模型。核心：Cox比例风险/随机生存森林/深度学习(DeepSurv/DSM/MTLR)/贝叶斯模型平均/Super Learner集成。C-index ≥ 0.85。"@zh ;
    rdfs:subClassOf hfsco:FengShuiEntity ;
    dcterms:source "《精算数学》《生存分析》《机器学习生存分析》" .

hfsco-act:ChineseLifeTable a owl:Class ;
    rdfs:label "中国人寿表"@zh, "Chinese Life Table"@en ;
    rdfs:comment "中国精算师协会发布的第4/5/6/7次国家人寿表、行业经验寿表、分地区/城乡/职业/收入分层寿表。精算定价/储备/偿付能力核心依据。"@zh ;
    rdfs:subClassOf hfsco:FengShuiEntity ;
    dcterms:source "中国精算师协会/《中国人寿表》第4-7次" .

hfsco-act:ExperienceRate a owl:Class ;
    rdfs:label "经验率/精算因子"@zh, "Experience Rate / Actuarial Factor"@en ;
    rdfs:comment "基于行业/自产数据统计的：死亡率/疾病率/重疾率/给付率/退保率/费用率/投资收益率/红利演示利率/偿付能力因子/风险保费率/净保费/储备金因子。分年龄/性别/职业/地区/险种/渠道/时期。"@zh ;
    rdfs:subClassOf hfsco:FengShuiEntity ;
    dcterms:source "中国精算师协会/行业经验率/自产经验率" .

hfsco-act:Level1AAssumption a owl:Class ;
    rdfs:label "Level 1A 假设"@zh, "Level 1A Assumption"@en ;
    rdfs:comment "精算模型最高级验证标准：10个核心假设全达标。1)数据质量 2)模型规范 3)参数估计 4)模型验证 5)敏感性分析 6)压力测试 7)独立验证 7)文档完整 9)治理流程 10)监管报送。C-index ≥ 0.85，校准曲线良好，NRI/IDI 显著。"@zh ;
    rdfs:subClassOf hfsco:FengShuiProcess ;
    dcterms:source "精算备忘录规范/监管规则/国际精算实务准则" .

hfsco-act:ActuarialMemorandum a owl:Class ;
    rdfs:label "精算备忘录"@zh, "Actuarial Memorandum"@en ;
    rdfs:comment "精算师对模型/假设/数据/方法/结果/不确定性/敏感性/合规性/建议的完整书面记录。监管审核/偿付能力报告/产品备案核心文档。"@zh ;
    rdfs:subClassOf hfsco:FengShuiEntity ;
    dcterms:source "精算备忘录规范/监管规则" .

hfsco-act:SolvencyFactor a owl:Class ;
    rdfs:label "偿付能力因子"@zh, "Solvency Factor"@en ;
    rdfs:comment "C-ROSS/偿二代核心因子：风险边界/相关性/分散化/调整系数/冲击场景/恢复期/资本充足率/最低资本要求/风险触发事件/整改措施。"@zh ;
    rdfs:subClassOf hfsco-act:ExperienceRate ;
    dcterms:source "C-ROSS/偿二代规则/中国银保监会" .

hfsco-act:ReserveFactor a owl:Class ;
    rdfs:label "储备金因子"@zh, "Reserve Factor"@en ;
    rdfs:comment "未到期责任准备金/未决赔款准备金/风险准备金/灾害准备金/充足性测试/锁定假设/最佳估计/风险边际/释放利润/盈余测试。"@zh ;
    rdfs:subClassOf hfsco-act:ExperienceRate ;
    dcterms:source "精算准则/监管报送标准" .

hfsco-act:CompetingRiskModel a owl:Class ;
    rdfs:label "竞争风险模型"@zh, "Competing Risk Model"@en ;
    rdfs:comment "多重终点事件(死亡/疾病/退保/给付/转移/失访)竞争风险建模：Fine-Gray 亚分布风险/原因特异性风险/累积发生函数/灰色模型/多状态模型转移强度。"@zh ;
    rdfs:subClassOf hfsco-act:SurvivalModel ;
    dcterms:source "《竞争风险生存分析》《多状态模型》" .

hfsco-act:MultiStateModel a owl:Class ;
    rdfs:label "多状态模型"@zh, "Multi-State Model"@en ;
    rdfs:comment "健康/亚健康/疾病/重疾/残疾/康复/死亡等多状态转移：转移强度矩阵/转移概率/停留时间/吸收状态/可逆/不可逆/马尔可夫/半马尔可夫/非马尔可夫。精算/健康管理/疾病管理核心。"@zh ;
    rdfs:subClassOf hfsco-act:CompetingRiskModel ;
    dcterms:source "《多状态模型在精算中的应用》" .

hfsco-act:FactorGovernance a owl:Class ;
    rdfs:label "因子治理"@zh, "Factor Governance"@en ;
    rdfs:comment "精算因子全生命周期管理：数据血缘/版本控制/变更审批/独立验证/回测/监控/报告/审计/归档/合规/监管报送。核心：因子库/因子版本/因子变更/因子审计。"@zh ;
    rdfs:subClassOf hfsco:FengShuiProcess ;
    dcterms:source "精算因子治理规范/监管规则/国际精算实务准则" .

# ============================================================
# 核心关系 (精算特有)
# ============================================================

hfsco-act:predicts a owl:ObjectProperty ;
    rdfs:label "预测"@zh, "predicts"@en ;
    rdfs:domain hfsco-act:SurvivalModel ;
    rdfs:range hfsco-act:ExperienceRate ;
    rdfs:comment "生存模型预测特定经验率/因子"@zh .

hfsco-act:validatesAgainst a owl:ObjectProperty ;
    rdfs:label "验证对标"@zh, "validates against"@en ;
    rdfs:domain hfsco-act:Level1AAssumption ;
    rdfs:range hfsco-act:ActuarialMemorandum ;
    rdfs:comment "Level 1A 假设在精算备忘录中验证对标"@zh .

hfsco-act:hasFactorVersion a owl:ObjectProperty ;
    rdfs:label "具有因子版本"@zh, "has factor version"@en ;
    rdfs:domain hfsco-act:ExperienceRate ;
    rdfs:range hfsco-act:ExperienceRate ;
    rdfs:comment "精算因子版本管理关系"@zh .

hfsco-act:governs a owl:ObjectProperty ;
    rdfs:label "治理"@zh, "governs"@en ;
    rdfs:domain hfsco-act:FactorGovernance ;
    rdfs:range hfsco-act:ExperienceRate ;
    rdfs:comment "因子治理过程管辖特定精算因子"@zh .

hfsco-act:calibratedOn a owl:ObjectProperty ;
    rdfs:label "基于...校准"@zh, "calibrated on"@en ;
    rdfs:domain hfsco-act:EpigeneticClock ;
    rdfs:range hfsco-act:EpigeneticClock ;
    rdfs:comment "表观遗传时钟基于特定队列/数据集校准"@zh .

# ============================================================
# 种子实例
# ============================================================

hfsco-act:model-chinese-grimage-v2 a hfsco-act:ChineseGrimAge ;
    rdfs:label "Chinese-GrimAge v2.0"@zh, "Chinese-GrimAge v2.0"@en ;
    rdfs:comment "基于 CKB/CHARLS/CLHLS/百岁/自建队列训练，C-index 0.871，校准良好，Level 1A 10/10"@zh ;
    hfsco-act:calibratedOn hfsco-act:cohort-ckb-charls-clhls .

hfsco-act:cohort-ckb-charls-clhls a hfsco-act:EpigeneticClock ;
    rdfs:label "CKB+CHARLS+CLHLS+百岁+自建队列"@zh, "CKB+CHARLS+CLHLS+Centenarian+Custom Cohort"@en ;
    rdfs:comment "多队列联合训练数据集，样本量>100k，覆盖全龄段/城乡/地区/职业"@zh .

hfsco-act:assumption-level1a-v2 a hfsco-act:Level1AAssumption ;
    rdfs:label "Level 1A 假设 v2.0"@zh, "Level 1A Assumption v2.0"@en ;
    rdfs:comment "Chinese-GrimAge v2.0 + 精算生存模型集成，10个核心假设全达标，C-index 0.871"@zh ;
    hfsco-act:validatesAgainst hfsco-act:memo-v2 .

hfsco-act:memo-v2 a hfsco-act:ActuarialMemorandum ;
    rdfs:label "Chinese-GrimAge v2.0 精算备忘录"@zh, "Chinese-GrimAge v2.0 Actuarial Memorandum"@en ;
    rdfs:comment "完整记录：数据/模型/假设/验证/敏感性/压力测试/独立验证/治理/合规/建议"@zh .